10 IF PEEK(&HFF92)=64 THEN POKE 65496,0 ELSE POKE 65494,0
20 LOADM "SOLVER.BIN"
30 IF PEEK(&HFF92)=64 THEN POKE 65497,0 ELSE POKE 65495,0
40 CLEAR 500,&H5FFF
50 DIM B(9,9),F(9,9),SL(9,9),EC(81),TK(81)
60 CLS:FL$=""
70 PRINT @ 38,"* COCO SUDOKU V2.1 *"
80 PRINT @ 135,"SELECT DIFFICULTY:"
90 PRINT @ 193,"E) EASY   PROVIDES 36-40 CELLS"
100 PRINT @ 225,"M) MEDIUM PROVIDES 30-35 CELLS"
110 PRINT @ 257,"H) HARD   PROVIDES 25-29 CELLS"
120 PRINT @ 289,"X) EXPERT PROVIDES 22-24 CELLS"
130 PRINT @ 353,"S) COCO SOLVES YOUR PUZZLE"
140 PRINT @ 385,"I) INSTRUCTIONS"
150 PRINT @ 453,"PRESS E M H X S OR I"
160 K$=INKEY$:IF K$="" THEN 160
170 K$=CHR$(ASC(K$) AND 223)
180 IF K$="E" THEN FL$="EASY.DAT":DF$="EASY"
190 IF K$="M" THEN FL$="MEDIUM.DAT":DF$="MEDIUM"
200 IF K$="H" THEN FL$="HARD.DAT":DF$="HARD"
210 IF K$="X" THEN FL$="EXPERT.DAT":DF$="EXPERT"
220 IF K$="S" THEN GOTO 1360
230 IF K$="I" THEN GOTO 1210
240 IF FL$="" THEN 160
250 IF PEEK(&HFF92)=64 THEN POKE 65496,0 ELSE POKE 65494,0
260 OPEN "R",#1,FL$,162
270 FIELD #1,81 AS PD$,81 AS SO$
280 GET #1,1
290 CT=VAL(PD$)
300 IF CT<1 THEN CLOSE #1:PRINT @ 288," NO PUZZLES IN FILE!":FOR DL=1 TO 3000:NEXT:GOTO 60
310 CLS
320 PRINT @ 38,DF$+" HAS";CT;"PUZZLES!"
330 PRINT @ 102,"ENTER PUZZLE NUMBER"
340 PRINT @ 134,"OR 0 FOR RANDOM";
350 INPUT PN
360 IF PN<0 OR PN>CT THEN 310
370 IF PN=0 THEN X=RND(-TIMER):PN=RND(CT)
380 RN=PN+1
390 PRINT @ 230,"LOADING PUZZLE "+MID$(STR$(PN),2)+"..."
400 GET #1,RN
410 PP$=PD$
420 SS$=SO$
430 CLOSE #1
440 IF PEEK(&HFF92)=64 THEN POKE 65497,0 ELSE POKE 65495,0
450 HC=0:RM=5
460 FOR R=1 TO 9:FOR C=1 TO 9
470 I=(R-1)*9+C
480 B(R,C)=VAL(MID$(PP$,I,1))
490 F(R,C)=SGN(B(R,C))
500 SL(R,C)=VAL(MID$(SS$,I,1))
510 NEXT C:NEXT R
520 CLS
530 SP$="+-----+-----+-----+"
540 PRINT @ 0,DF$+" #"+MID$(STR$(PN),2):PRINT @ 17,"Q=QUIT R=RESET":PRINT @ 56,"F=SOLVE"
550 PRINT @ 64,SP$
560 FOR R=1 TO 9
570 SR=2+R+INT((R-1)/3)
580 LN$=":"
590 FOR C=1 TO 9
600 IF B(R,C)=0 THEN LN$=LN$+"." ELSE LN$=LN$+CHR$(48+B(R,C))
610 IF C/3<>INT(C/3) THEN LN$=LN$+" " ELSE LN$=LN$+":"
620 NEXT C
630 PRINT @ SR*32,LN$
640 IF R=3 OR R=6 THEN PRINT @ (SR+1)*32,SP$
650 NEXT R
660 PRINT @ 448,SP$
670 PRINT @ 480,"H=HINT(";RIGHT$(STR$(RM),1);") 1-9=ENTER      0=CLR";
680 CR=1:CC=1
690 PS=(2+CR+INT((CR-1)/3))*32+1+2*(CC-1)
700 CP=1024+PS
710 OV=110:IF B(CR,CC)>0 THEN OV=112+B(CR,CC)
720 POKE CP,OV-64
730 K$=INKEY$:IF K$="" THEN 730
740 POKE CP,OV
750 IF K$="Q" OR K$="q" THEN GOTO 60
760 IF K$="R" OR K$="r" THEN GOTO 450
770 D=VAL(K$)
780 IF D>=1 AND D<=9 AND F(CR,CC)=0 THEN B(CR,CC)=D:OV=112+D:POKE CP,OV:GOTO 900
790 IF (K$="0" OR K$=" ") AND F(CR,CC)=0 THEN B(CR,CC)=0:OV=110:POKE CP,OV-64:GOTO 730
800 IF D>=1 AND D<=9 THEN POKE CP,OV-64:GOTO 730
810 IF K$="H" OR K$="h" THEN GOTO 1040
820 IF K$="F" OR K$="f" THEN POKE CP,OV-64:GOTO 1130
830 IF K$="W" OR K$="w" OR K$=CHR$(94) THEN CR=CR-1:IF CR<1 THEN CR=9
840 IF K$="S" OR K$="s" OR K$=CHR$(10) THEN CR=CR+1:IF CR>9 THEN CR=1
850 IF K$="A" OR K$="a" OR K$=CHR$(8) THEN CC=CC-1:IF CC<1 THEN CC=9
860 IF K$="D" OR K$="d" OR K$=CHR$(9) THEN CC=CC+1:IF CC>9 THEN CC=1
870 PS=(2+CR+INT((CR-1)/3))*32+1+2*(CC-1):CP=1024+PS
880 OV=110:IF B(CR,CC)>0 THEN OV=112+B(CR,CC)
890 POKE CP,OV-64:GOTO 730
900 WN=1
910 FOR RX=1 TO 9:FOR GC=1 TO 9
920 IF B(RX,GC)<>SL(RX,GC) THEN WN=0:RX=9:GC=9
930 NEXT GC:NEXT RX
940 IF WN=0 THEN POKE CP,OV-64:GOTO 730
950 SOUND 50,5:SOUND 90,10:FOR D=1 TO 500:NEXT D:CLS:PRINT @ 0,DF$+" #"+MID$(STR$(PN),2)
960 PRINT @ 192,"      ** PUZZLE SOLVED! **"
970 PRINT @ 224,"         HINTS USED:";HC
980 PRINT @ 256,"         PRESS ANY KEY..."
990 IF HC=81 THEN PRINT @ 320,"     COCO SOLVED THIS ONE..."
1000 K$=INKEY$:IF K$="" THEN 1000
1010 K$=INKEY$:REM CLEAR ANY BUFFERED KEY
1020 IF PEEK(&HFF92)=64 THEN POKE 65497,0 ELSE POKE 65495,0
1030 GOTO 60
1040 IF HC>=5 THEN POKE CP,OV-64:GOTO 730
1050 IF F(CR,CC)<>0 THEN POKE CP,OV-64:GOTO 730
1060 IF B(CR,CC)=SL(CR,CC) THEN POKE CP,OV-64:GOTO 730
1070 HC=HC+1:RM=RM-1
1080 B(CR,CC)=SL(CR,CC)
1090 OV=112+SL(CR,CC)
1100 POKE CP,OV
1110 PRINT @ 480,"H=HINT(";RIGHT$(STR$(RM),1);") 1-9=ENTER      0=CLR";
1120 GOTO 900
1130 PRINT @ 480,"PRESS F AGAIN TO REVEAL...     ";
1140 K$=INKEY$:IF K$="" THEN 1140
1150 IF K$<>"F" AND K$<>"f" THEN PRINT @ 480,"H=HINT(";RIGHT$(STR$(RM),1);") 1-9=ENTER      0=CLR";:GOTO 730
1160 HC=81:RM=0
1170 FOR R=1 TO 9:FOR C=1 TO 9:B(R,C)=SL(R,C):F(R,C)=1
1180 PS=(2+R+INT((R-1)/3))*32+1+2*(C-1):POKE 1024+PS,112+B(R,C)
1190 NEXT C:NEXT R
1200 GOTO 900
1210 CLS
1220 PRINT @ 0,  "    * SUDOKU INSTRUCTIONS *    "
1230 PRINT @ 32, " FILL THE 9X9 GRID WITH NUMBERS"
1240 PRINT @ 64, "   1-9, NO REPEATS IN ANY ROW, "
1250 PRINT @ 96, "     COLUMN, OR 3X3 SUBGRID.   "
1260 PRINT @ 160, "           CONTROLS:           "
1270 PRINT @ 224, " WASD/ARROWS: MOVE"
1280 PRINT @ 256, " 1-9: ENTER DIGIT"
1290 PRINT @ 288, " 0/SPACE: CLEAR"
1300 PRINT @ 320, " H: HINT (UP TO 5)"
1310 PRINT @ 352, " R: RESET PUZZLE"
1320 PRINT @ 384, " Q: QUIT TO MENU"
1330 PRINT @ 448, "        PRESS ANY KEY...       "
1340 K$=INKEY$:IF K$="" THEN 1340
1350 GOTO 60
1360 FOR R=1 TO 9:FOR C=1 TO 9:B(R,C)=0:F(R,C)=0:SL(R,C)=0:NEXT C:NEXT R
1370 CLS
1380 SP$="+-----+-----+-----+"
1390 PRINT @ 0,"*** SOLVE YOUR PUZZLE ***"
1400 PRINT @ 64,SP$
1410 FOR R=1 TO 9
1420 SR=2+R+INT((R-1)/3)
1430 LN$=":"
1440 FOR C=1 TO 9
1450 LN$=LN$+".":IF C/3<>INT(C/3) THEN LN$=LN$+" " ELSE LN$=LN$+":"
1460 NEXT C
1470 PRINT @ SR*32,LN$
1480 IF R=3 OR R=6 THEN PRINT @ (SR+1)*32,SP$
1490 NEXT R
1500 PRINT @ 448,SP$
1510 PRINT @ 480,"1-9=ENTER 0=CLR F=SOLVE Q=QUIT";
1520 CR=1:CC=1
1530 PS=(2+CR+INT((CR-1)/3))*32+1+2*(CC-1)
1540 CP=1024+PS
1550 OV=110:IF B(CR,CC)>0 THEN OV=112+B(CR,CC)
1560 POKE CP,OV-64
1570 K$=INKEY$:IF K$="" THEN 1570
1580 POKE CP,OV
1590 IF K$="Q" OR K$="q" THEN GOTO 60
1600 IF K$="F" OR K$="f" THEN POKE CP,OV:GOTO 1710
1610 D=VAL(K$)
1620 IF D>=1 AND D<=9 THEN B(CR,CC)=D:F(CR,CC)=1:OV=112+D:POKE CP,OV-64:GOTO 1570
1630 IF (K$="0" OR K$=" ") THEN B(CR,CC)=0:F(CR,CC)=0:OV=110:POKE CP,OV-64:GOTO 1570
1640 IF K$="W" OR K$="w" OR K$=CHR$(94) THEN CR=CR-1:IF CR<1 THEN CR=9
1650 IF K$="S" OR K$="s" OR K$=CHR$(10) THEN CR=CR+1:IF CR>9 THEN CR=1
1660 IF K$="A" OR K$="a" OR K$=CHR$(8) THEN CC=CC-1:IF CC<1 THEN CC=9
1670 IF K$="D" OR K$="d" OR K$=CHR$(9) THEN CC=CC+1:IF CC>9 THEN CC=1
1680 PS=(2+CR+INT((CR-1)/3))*32+1+2*(CC-1):CP=1024+PS
1690 OV=110:IF B(CR,CC)>0 THEN OV=112+B(CR,CC)
1700 POKE CP,OV-64:GOTO 1570
1710 PRINT @ 480,"SOLVING...                     ";
1720 FOR R=1 TO 9:FOR C=1 TO 9
1730 POKE &H6000+(R-1)*9+(C-1),B(R,C)
1740 NEXT C:NEXT R
1750 EXEC &H6200
1760 IF PEEK(&H612A)=0 THEN GOTO 1870
1770 FOR R=1 TO 9:FOR C=1 TO 9
1780 B(R,C)=PEEK(&H6000+(R-1)*9+(C-1))
1790 NEXT C:NEXT R
1800 FOR R=1 TO 9:FOR C=1 TO 9
1810 PS=(2+R+INT((R-1)/3))*32+1+2*(C-1):POKE 1024+PS,112+B(R,C)
1820 NEXT C:NEXT R
1830 SOUND 50,5:SOUND 90,10:PRINT @ 480,"** SOLVED! **  PRESS ANY KEY  ";
1840 K$=INKEY$:IF K$="" THEN 1840
1850 K$=INKEY$:REM CLEAR BUFFER
1860 GOTO 60
1870 FOR R=1 TO 9:FOR C=1 TO 9
1880 IF F(R,C)=0 THEN B(R,C)=0:PS=(2+R+INT((R-1)/3))*32+1+2*(C-1):POKE 1024+PS,110
1890 NEXT C:NEXT R
1900 SOUND 90,5:SOUND 50,10:PRINT @ 480,"NO SOLUTION!   PRESS ANY KEY  ";
1910 K$=INKEY$:IF K$="" THEN 1910
1920 K$=INKEY$:REM CLEAR BUFFER
1930 GOTO 60
